{
  // Worker name — becomes atsy.<account>.workers.dev.
  // Renaming later changes the URL and strands the old worker.
  "name": "atsy",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  // Primary URL — custom domain on the vibecod3.app zone (same Cloudflare
  // account as pricey.vibecod3.app). Wrangler provisions DNS + certificate.
  "routes": [{ "pattern": "atsy.vibecod3.app", "custom_domain": true }],
  // Keep the workers.dev URL live too, so old links never break.
  "workers_dev": true,
  // Static assets in ./dist are served first; unmatched routes (/api/*) fall
  // through to worker.js. Custom asset headers live in public/_headers.
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atsy-db",
      // Local `wrangler dev` ignores this id and uses a local SQLite file, so
      // development and E2E work without it. Created 2026-08-31 by the
      // provision workflow.
      "database_id": "53cd59e3-1822-4b78-b2d6-cabbadeaba8d"
    }
  ],
  // Sends the sign-in codes. vibecod3.app is already onboarded as a sending
  // domain, so this needs no secret.
  "send_email": [{ "name": "SEND_EMAIL" }],
  "vars": {
    // OTP_ECHO and TURNSTILE_BYPASS are local/E2E flags passed with
    // `wrangler dev --var`. They must NEVER appear in this file.
    "ADMIN_EMAILS": "avishkapadia@gmail.com",
    "OWNER_EMAIL": "avishkapadia@gmail.com",
    "EMAIL_FROM": "hello@vibecod3.app",
    // Turnstile site keys are public. This is Cloudflare's always-passes test
    // key: replace it with the real key for atsy.vibecod3.app, and add the
    // matching TURNSTILE_SECRET_KEY as a GitHub secret so CI can sync it.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
  // Added in later milestones:
  //   M2  r2_buckets: CV -> atsy-cv, ai binding, ratelimits,
  //       cron trigger for the retention sweep
}
