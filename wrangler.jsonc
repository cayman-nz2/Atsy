{
  // Worker name — becomes atsy.<account>.workers.dev.
  // Renaming later changes the URL and strands the old worker.
  "name": "atsy",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  // Primary URL — custom domain on the vibecod3.app zone (same Cloudflare
  // account as pricey.vibecod3.app). Wrangler provisions DNS + certificate.
  "routes": [{ "pattern": "atsy.vibecod3.app", "custom_domain": true }],
  // Keep the workers.dev URL live too, so old links never break.
  "workers_dev": true,
  // Static assets in ./dist are served first; unmatched routes (/api/*) fall
  // through to worker.js. Custom asset headers live in public/_headers.
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atsy-db-oc",
      // Local `wrangler dev` ignores this id and uses a local SQLite file, so
      // development and E2E work without it.
      //
      // Created 2026-09-01 with `--location oc`; D1 serves it from Auckland.
      // The region is fixed at creation, so moving again means a new database
      // and another copy — see .github/workflows/migrate-to-oceania.yml.
      "database_id": "f81e31c5-788f-499e-b52e-6fb5b087cefd"
    }
  ],
  // Holds application-encrypted CV bytes and nothing else: no filename, no
  // user id, no metadata. Created 2026-09-01 with `--location oc`.
  //
  // The old atsy-cv bucket in ENAM is left in place and drains itself: every
  // object in it is deleted within 24 hours of its upload.
  "r2_buckets": [{ "binding": "CV", "bucket_name": "atsy-cv-oc" }],
  // Sends the sign-in codes. vibecod3.app is already onboarded as a sending
  // domain, so this needs no secret.
  "send_email": [{ "name": "SEND_EMAIL" }],
  // Retention sweep. Every 30 minutes, so a file is never more than half an
  // hour past its window. See src/retention.js.
  "triggers": { "crons": ["*/30 * * * *"] },
  // Bullet rewrites only — never scoring, which is deterministic by design.
  // A daily neuron budget in src/rewrite.js keeps this free, and the product
  // degrades to deterministic guidance when the budget is spent.
  "ai": { "binding": "AI" },
  "vars": {
    // OTP_ECHO and TURNSTILE_BYPASS are local/E2E flags passed with
    // `wrangler dev --var`. They must NEVER appear in this file.
    "ADMIN_EMAILS": "avishkapadia@gmail.com",
    "OWNER_EMAIL": "avishkapadia@gmail.com",
    "EMAIL_FROM": "atsyhello@vibecod3.app",
    // Every email Atsy sends is copied to the owner and replies come back to
    // him. The copy is a separate send: the Email Service envelope carries one
    // recipient, so a Bcc header alone would deliver nothing.
    "BCC_EMAIL": "avishkapadia@gmail.com",
    "REPLY_TO_EMAIL": "avishkapadia@gmail.com",
    // Turnstile site keys are public. This is the real widget for
    // atsy.vibecod3.app, created by the provision workflow; its secret lives
    // only as a Worker secret and was never printed.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEivQffZlB2yC1wA",
    // Retention windows, in the units the promise on /privacy is written in.
    // Overridable so a test can prove the sweep works without waiting a day.
    "FILE_RETENTION_HOURS": "24",
    "RECORD_RETENTION_DAYS": "30"
  }
}
