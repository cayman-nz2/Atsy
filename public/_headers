# Custom headers for static assets. These do NOT apply to responses generated
# by worker.js — those set their own in src/util.js (SECURITY_HEADERS).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# The sign-in page embeds Turnstile — the only third-party code Atsy loads
# anywhere. It is allowed here and nowhere else.
#
# This page also runs the X-ray, which is why its policy is wider than the
# site-wide one in three places, all of them same-origin or in-memory:
#   worker-src   PDF.js renders in a worker, loaded from /vendor/pdfjs/.
#   blob:/data:  the decoded page and the fonts embedded in the reader's own
#                PDF become blobs and data URLs inside the browser. They are
#                the reader's file, not a third party's, and no host is added.
# 'unsafe-eval' is NOT granted: PDF.js is started with isEvalSupported false.
#
# The `! Content-Security-Policy` line is load-bearing, not tidying. EVERY rule
# that matches a request is applied — a more specific path does not replace the
# broader one — so without it the response carries two policies, and a browser
# enforces all of them and keeps the strictest answer for each directive. The
# site-wide `script-src 'self'` then silently overrode the wider policy below
# and the sign-in bot check could not load at all. Delete the line and the
# front door breaks; a unit test and a post-deploy check both refuse it.
/app
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: https://challenges.cloudflare.com; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

/app.html
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: https://challenges.cloudflare.com; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# The admin view loads no third-party code at all, so it keeps the strict
# site-wide policy and is listed here only to say so deliberately.
/admin
  X-Robots-Tag: noindex, nofollow

/admin.html
  X-Robots-Tag: noindex, nofollow

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
